PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Safepay — create a Sandbox account first
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=sec_your_public_safepay_key
SAFEPAY_SECRET_KEY=your_private_safepay_secret

# Google Sign-In
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Email (SMTP) — leave unset to have emails logged instead of sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# WhatsApp Business Cloud API — leave unset to have messages logged instead of sent
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
